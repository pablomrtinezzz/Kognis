# ==========================================
# Frontend Environment Variables Template
# ==========================================

# Supabase Public Configuration
# These are safe to expose to the browser for client-side Auth and DB queries
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"

# FastAPI Backend URL (defaults to http://localhost:8000 if not set)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ── Dev only ──────────────────────────────────────────────────────────────────
# Set to "true" to skip Supabase Auth and inject a fake session automatically.
# Lets you test the full UI (Dashboard, Workouts) without a real Supabase project.
# NEVER set this to true in production.
NEXT_PUBLIC_BYPASS_AUTH="true"
