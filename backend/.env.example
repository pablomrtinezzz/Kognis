# ==========================================
# Backend Environment Variables Template
# ==========================================

# Core Application Settings
ENVIRONMENT="development"

# IANA timezone string for the scheduler cron (e.g. "America/Mexico_City", "Europe/Madrid", "UTC")
TIMEZONE="UTC"

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Configuration
# You will get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret-from-auth-settings"

# Dev auth bypass — only used when BYPASS_AUTH=true and ENVIRONMENT=development
BYPASS_AUTH=false
DEV_BYPASS_TOKEN="change-this-to-any-secret-string"

# AI Integration (Cognitive Module)
GEMINI_API_KEY="your-google-gemini-api-key"
