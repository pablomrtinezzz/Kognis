# ==========================================
# Backend Environment Variables Template
# ==========================================

# Core Application Settings
ENVIRONMENT="development"
# The secret key for signing internal tokens (if needed later)
SECRET_KEY="your-super-secret-key-change-this-in-production"

# Supabase Configuration
# You will get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret-from-auth-settings"

# AI Integration (Cognitive Module)
GEMINI_API_KEY="your-google-gemini-api-key"
